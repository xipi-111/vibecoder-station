{
  "name": "vibecoder-station",
  "version": "0.1.2",
  "description": "A minimal cross-platform desktop video player for the VibeCoder station.",
  "author": "xipi-111",
  "license": "MIT",
  "homepage": "https://github.com/xipi-111/vibecoder-station#readme",
  "bugs": {
    "url": "https://github.com/xipi-111/vibecoder-station/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xipi-111/vibecoder-station.git"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "test:douyin-catalog": "electron electron/douyin-catalog-smoke.cjs",
    "test:douyin-creator": "electron electron/douyin-creator-smoke.cjs",
    "test:douyin-image": "electron electron/douyin-image-smoke.cjs",
    "test:douyin": "electron electron/douyin-source-smoke.cjs",
    "test:config": "node electron/local-douyin-config-smoke.cjs",
    "test:ordering": "node electron/local-douyin-ordering-smoke.cjs",
    "test:manager-window": "node scripts/manager-window-e2e.mjs",
    "test:transport": "electron electron/transport-smoke.cjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "animejs": "^4.5.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "cross-env": "^10.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.vibecoder.station",
    "productName": "VibeCoder 加油站",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
